+void side_set_custom_colour(uint8_t r, uint8_t g, uint8_t b)
+{
+    colour_lib[SIDE_COLOUR_CUSTOM][0] = r;
+    colour_lib[SIDE_COLOUR_CUSTOM][1] = g;
+    colour_lib[SIDE_COLOUR_CUSTOM][2] = b;
+
+    colour_lib_1[SIDE_COLOUR_CUSTOM][0] = (uint8_t)(((uint16_t)r * 0x70) / 0xff);
+    colour_lib_1[SIDE_COLOUR_CUSTOM][1] = (uint8_t)(((uint16_t)g * 0x70) / 0xff);
+    colour_lib_1[SIDE_COLOUR_CUSTOM][2] = (uint8_t)(((uint16_t)b * 0x70) / 0xff);
+}
+
+void side_get_custom_colour(uint8_t *rgb)
+{
+    rgb[0] = colour_lib[SIDE_COLOUR_CUSTOM][0];
+    rgb[1] = colour_lib[SIDE_COLOUR_CUSTOM][1];
+    rgb[2] = colour_lib[SIDE_COLOUR_CUSTOM][2];
+}
+
+void side_sanitize(void)
+{
+    if (side_mode_a > SIDE_STATIC)    side_mode_a = SIDE_WAVE;
+    if (side_mode_b > SIDE_MODE_7)    side_mode_b = SIDE_MODE_4;
+    if (side_light > 4)               side_light  = 2;
+    if (side_speed > LIGHT_SPEED_MAX) side_speed  = LIGHT_SPEED_MAX / 2;
+    if (side_rgb > 1)                 side_rgb    = 1;
+
+    if (side_mode_a == SIDE_NEW) {
+        if (side_colour >= SIDE_NEW_COLOUR_MAX) side_colour = 0;
+    } else if (side_colour > SIDE_COLOUR_CUSTOM) {
+        side_colour = 0;
+    }
+}
