+
+#ifdef VIA_ENABLE
+enum keyglow_value_id {
+    KG_ID_PROBE       = 0x00,
+    KG_ID_SIDE_MODE_A = 0x01,
+    KG_ID_SIDE_MODE_B = 0x02,
+    KG_ID_SIDE_LIGHT  = 0x03,
+    KG_ID_SIDE_SPEED  = 0x04,
+    KG_ID_SIDE_RGB    = 0x05,
+    KG_ID_SIDE_COLOUR = 0x06,
+    KG_ID_SIDE_CUSTOM = 0x07,
+    KG_ID_SIDE_ALL    = 0x10,
+    KG_ID_BATTERY     = 0x20,
+    KG_ID_CHARGE      = 0x21,
+    KG_ID_LINK        = 0x22,
+    KG_ID_STATUS      = 0x2F,
+};
+#define KG_PROTOCOL_VERSION 1
+#define KG_MAX_VALUE_LEN    9
+
+static bool kg_is_writable(uint8_t id)
+{
+    return (id >= KG_ID_SIDE_MODE_A && id <= KG_ID_SIDE_CUSTOM) || id == KG_ID_SIDE_ALL;
+}
+
+static bool kg_get_value(uint8_t id, uint8_t *v)
+{
+    switch (id) {
+        case KG_ID_PROBE:
+            v[0] = 'K';
+            v[1] = 'G';
+            v[2] = KG_PROTOCOL_VERSION;
+            break;
+        case KG_ID_SIDE_MODE_A: v[0] = side_mode_a; break;
+        case KG_ID_SIDE_MODE_B: v[0] = side_mode_b; break;
+        case KG_ID_SIDE_LIGHT:  v[0] = side_light;  break;
+        case KG_ID_SIDE_SPEED:  v[0] = side_speed;  break;
+        case KG_ID_SIDE_RGB:    v[0] = side_rgb;    break;
+        case KG_ID_SIDE_COLOUR: v[0] = side_colour; break;
+        case KG_ID_SIDE_CUSTOM: side_get_custom_colour(&v[0]); break;
+        case KG_ID_SIDE_ALL:
+            v[0] = side_mode_a;
+            v[1] = side_mode_b;
+            v[2] = side_light;
+            v[3] = side_speed;
+            v[4] = side_rgb;
+            v[5] = side_colour;
+            side_get_custom_colour(&v[6]);
+            break;
+        case KG_ID_BATTERY:
+            v[0] = dev_info.rf_baterry;
+            break;
+        case KG_ID_CHARGE:
+            v[0] = dev_info.rf_charge;
+            v[1] = f_charging;
+            break;
+        case KG_ID_LINK:
+            v[0] = dev_info.link_mode;
+            v[1] = dev_info.rf_state;
+            v[2] = dev_info.rf_channel;
+            v[3] = dev_info.ble_channel;
+            break;
+        case KG_ID_STATUS:
+            v[0] = dev_info.rf_baterry;
+            v[1] = dev_info.rf_charge;
+            v[2] = dev_info.link_mode;
+            v[3] = dev_info.rf_state;
+            v[4] = dev_info.sys_sw_state;
+            v[5] = low_bat_flag;
+            v[6] = f_dev_sleep_enable;
+            break;
+        default:
+            return false;
+    }
+    return true;
+}
+
+static bool kg_set_value(uint8_t id, const uint8_t *v)
+{
+    switch (id) {
+        case KG_ID_SIDE_MODE_A:
+            if (v[0] > 4) return false;
+            if (v[0] != side_mode_a) side_play_point = 0;
+            side_mode_a = v[0];
+            break;
+        case KG_ID_SIDE_MODE_B:
+            if (v[0] > 6) return false;
+            if (v[0] != side_mode_b) side_play_point = 0;
+            side_mode_b = v[0];
+            break;
+        case KG_ID_SIDE_LIGHT:
+            if (v[0] > 4) return false;
+            side_light = v[0];
+            break;
+        case KG_ID_SIDE_SPEED:
+            if (v[0] > 4) return false;
+            side_speed = v[0];
+            break;
+        case KG_ID_SIDE_RGB:
+            if (v[0] > 1) return false;
+            if (v[0] != side_rgb) side_play_point = 0;
+            side_rgb = v[0];
+            break;
+        case KG_ID_SIDE_COLOUR:
+            if (v[0] > SIDE_COLOUR_CUSTOM) return false;
+            if (side_rgb) side_play_point = 0;
+            side_colour = v[0];
+            side_rgb    = 0;
+            break;
+        case KG_ID_SIDE_CUSTOM:
+            side_set_custom_colour(v[0], v[1], v[2]);
+            break;
+        case KG_ID_SIDE_ALL:
+            if (v[0] > 4 || v[1] > 6 || v[2] > 4 || v[3] > 4 || v[4] > 1 || v[5] > SIDE_COLOUR_CUSTOM) return false;
+            if (v[0] != side_mode_a || v[1] != side_mode_b || v[4] != side_rgb) side_play_point = 0;
+            side_mode_a = v[0];
+            side_mode_b = v[1];
+            side_light  = v[2];
+            side_speed  = v[3];
+            side_rgb    = v[4];
+            side_colour = v[5];
+            side_set_custom_colour(v[6], v[7], v[8]);
+            break;
+        default:
+            return false;
+    }
+
+    if (low_bat_flag && side_light > 1) side_light = 1;
+    side_sanitize();
+    return true;
+}
+
+static void kg_store_side(void)
+{
+    uint8_t rgb[3];
+
+    side_get_custom_colour(rgb);
+    user_config.ee_side_mode_a   = side_mode_a;
+    user_config.ee_side_mode_b   = side_mode_b;
+    if (!low_bat_flag || side_light == 0) user_config.ee_side_light = side_light;
+    user_config.ee_side_speed    = side_speed;
+    user_config.ee_side_rgb      = side_rgb;
+    user_config.ee_side_colour   = side_colour;
+    user_config.ee_side_custom_r = rgb[0];
+    user_config.ee_side_custom_g = rgb[1];
+    user_config.ee_side_custom_b = rgb[2];
+}
+
+void via_custom_value_command_kb(uint8_t *data, uint8_t length)
+{
+    uint8_t *command_id = &(data[0]);
+    uint8_t  channel_id = data[1];
+    uint8_t  value_id   = data[2];
+    uint8_t *value_data = &(data[3]);
+
+    if (channel_id != id_custom_channel || length < 3 + KG_MAX_VALUE_LEN) {
+        *command_id = id_unhandled;
+        return;
+    }
+
+    switch (*command_id) {
+        case id_custom_set_value:
+            if (kg_set_value(value_id, value_data)) {
+                kg_get_value(value_id, value_data);
+            } else {
+                *command_id = id_unhandled;
+            }
+            break;
+
+        case id_custom_get_value:
+            if (!kg_get_value(value_id, value_data)) {
+                *command_id = id_unhandled;
+            }
+            break;
+
+        case id_custom_save:
+            if (kg_is_writable(value_id)) {
+                kg_store_side();
+                eeconfig_update_user_datablock(&user_config);
+            } else {
+                *command_id = id_unhandled;
+            }
+            break;
+
+        default:
+            *command_id = id_unhandled;
+            break;
+    }
+}
+#endif
